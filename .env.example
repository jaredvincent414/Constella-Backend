# Ports are offset from the defaults so the stack won't collide with any
# Postgres/Redis you already run locally.
DATABASE_URL=postgresql://constella_postgres_2puj_user:RbqDkOSuVK9Mx6fkEoFUGG5LCU9Dpyrk@dpg-da4evbe7bikc7383m2o0-a/constella_postgres_2puj
REDIS_URL=redis://red-da4f19e1egvs73dh05hg:6379

# Connection pool. Pre-ping costs a round trip on every checkout; recycling
# covers an idled-out connection without one. Turn pre-ping on behind a proxy or
# failover pair, where connections can drop unannounced.
DB_POOL_PRE_PING=false
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# How long a resolved bearer token stays cached, in seconds. This is the window
# in which a deleted student could still authenticate — keep it short. 0 to
# disable the cache and hit Postgres on every authenticated request.
AUTH_CACHE_TTL_SECONDS=60

# Cache TTL for precomputed constellations, in seconds. This MUST be longer
# than the gap between `python -m app.jobs.recompute` runs — a TTL shorter than
# the job period leaves the cache cold for most of the day, and every request in
# the gap recomputes inline. 108000 = 30h, i.e. a daily job with headroom.
CACHE_TTL_SECONDS=108000

# Single-flight on a cache miss: how long the compute lock lives, and how long
# other callers wait for the winner before computing it themselves.
CACHE_LOCK_TTL_SECONDS=30
CACHE_LOCK_WAIT_SECONDS=2.0

# Constellation payload bounds (backend spec: top 50-200 alumni).
CONSTELLATION_MIN_ALUMNI=50
CONSTELLATION_MAX_ALUMNI=200

# What If Simulator returns the top N matches.
SIMULATOR_TOP_N=5

# Cluster edge pruning — must stay in sync with the frontend's render rules.
EDGE_MIN_WEIGHT=0.25
EDGE_MAX_COUNT=12

# CORS origin for the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://constella-view.vercel.app

LOG_LEVEL=INFO

# Shared key gating /api/admin (recompute, cache flush). Leave it UNSET to keep
# the admin surface disabled — unset means closed (503), not open. Set it to a
# long random value where admin access is actually needed:
#   ADMIN_API_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_API_KEY=
